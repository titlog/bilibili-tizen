<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://example.com/BiliSpike"
        version="1.0.0"
        viewmodes="maximized">

    <!-- The 10-char prefix must match the package attribute below.
         If Tizen Studio assigns you a different ID on import, let it win. -->
    <tizen:application id="BiLiSpiKe0.BiliSpike"
                       package="BiLiSpiKe0"
                       required_version="6.0"/>

    <!-- Wildcard network access. On Tizen this widget access policy replaces
         the browser CORS model, so XHR to bilivideo.com returns real status
         codes instead of opaque CORS errors. This is what makes test 01 work. -->
    <access origin="*" subdomains="true"/>

    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <icon src="icon.png"/>
    <name>bilibili</name>
    <description>bilibili client for Samsung TV</description>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <!-- bilibili ships DASH representations but no manifest, so one is built at
         runtime and written to wgt-private for AVPlay to open. Without these two
         tizen.filesystem.resolve throws Permission denied, synchronously. -->
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <!-- Several people share this television, and the engine's cookie jar is
         global: without a way to empty it, an account signed in through the web
         fallback would ride along on requests made under the next person's
         name. tizen.websetting.removeAllCookies is that way. Everything guards
         for its absence — Accounts.clearJar reports whether it worked. -->
    <tizen:privilege name="http://tizen.org/privilege/websetting"/>

    <tizen:profile name="tv-samsung"/>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
